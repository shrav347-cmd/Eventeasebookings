@model IEnumerable<EventeaseBookingSystem.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1 class="mb-3">Bookings</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">
        + Create New Booking
    </a>
</p>

<form method="get" asp-action="Index" class="mb-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Search and Filter Bookings</strong>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-12">
                    <label class="form-label">Search</label>
                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Search by Booking ID, Event, Venue, or Customer..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Event Type</label>
                    <select name="eventTypeId" class="form-control" asp-items="ViewBag.EventTypeID">
                        <option value="">All Event Types</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Venue</label>
                    <select name="venueId" class="form-control" asp-items="ViewBag.VenueID">
                        <option value="">All Venues</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Availability</label>
                    <select name="availability" class="form-control">
                        <option value="">All</option>

                        @if (ViewData["Availability"]?.ToString() == "Available")
                        {
                            <option value="Available" selected>Check Available</option>
                        }
                        else
                        {
                            <option value="Available">Check Available</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Start Date</label>
                    <input type="datetime-local"
                           name="startDate"
                           value="@ViewData["StartDate"]"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">End Date</label>
                    <input type="datetime-local"
                           name="endDate"
                           value="@ViewData["EndDate"]"
                           class="form-control" />
                </div>

                <div class="col-md-12 mt-3">
                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Clear
                    </a>
                </div>

            </div>
        </div>
    </div>
</form>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Booking ID</th>
            <th>Venue</th>
            <th>Event</th>
            <th>Event Type</th>
            <th>Customer</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted">
                    No bookings found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookingID</td>
                    <td>@item.Venue?.VenueName</td>
                    <td>@item.Event?.EventName</td>
                    <td>@item.Event?.EventType?.EventTypeName</td>
                    <td>@item.CustomerName</td>

                    <td>
                        @item.StartDate.ToString("dd MMM yyyy HH:mm")
                    </td>

                    <td>
                        @item.EndDate.ToString("dd MMM yyyy HH:mm")
                    </td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           asp-action="Edit"
                           asp-route-id="@item.BookingID">
                            Edit
                        </a>

                        <a class="btn btn-info btn-sm"
                           asp-action="Details"
                           asp-route-id="@item.BookingID">
                            Details
                        </a>

                        <a class="btn btn-danger btn-sm"
                           asp-action="Delete"
                           asp-route-id="@item.BookingID">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>