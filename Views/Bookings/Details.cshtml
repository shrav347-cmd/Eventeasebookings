@model EventeaseBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>

<div>
    <h4>Booking</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Booking ID
        </dt>
        <dd class="col-sm-10">
            @Model.BookingID
        </dd>

        <dt class="col-sm-2">
            Venue
        </dt>
        <dd class="col-sm-10">
            @Model.Venue?.VenueName
        </dd>

        <dt class="col-sm-2">
            Event
        </dt>
        <dd class="col-sm-10">
            @Model.Event?.EventName
        </dd>

        <dt class="col-sm-2">
            Event Type
        </dt>
        <dd class="col-sm-10">
            @Model.Event?.EventType?.EventTypeName
        </dd>

        <dt class="col-sm-2">
            Customer Name
        </dt>
        <dd class="col-sm-10">
            @Model.CustomerName
        </dd>

        <dt class="col-sm-2">
            Start Date
        </dt>
        <dd class="col-sm-10">
            @Model.StartDate.ToString("dd MMM yyyy HH:mm")
        </dd>

        <dt class="col-sm-2">
            End Date
        </dt>
        <dd class="col-sm-10">
            @Model.EndDate.ToString("dd MMM yyyy HH:mm")
        </dd>
    </dl>
</div>

<div>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.BookingID">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>